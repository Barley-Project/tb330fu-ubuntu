[org/gnome/desktop/session]
idle-delay=uint32 0

[org/gnome/desktop/screensaver]
lock-enabled=false
idle-activation-enabled=false

[org/gnome/settings-daemon/plugins/power]
sleep-inactive-ac-type='nothing'
sleep-inactive-battery-type='nothing'
# the power key is handled by tb330fu-keysd (short press: screen off/on, long press: power menu)
power-button-action='nothing'
idle-dim=false

[org/gnome/desktop/interface]
show-battery-percentage=true
enable-hot-corners=false

[org/gnome/desktop/wm/preferences]
button-layout='appmenu:minimize,maximize,close'

[org/gnome/mutter]
experimental-features=['scale-monitor-framebuffer']

[org/gnome/desktop/input-sources]
sources=[('xkb', 'us'), ('ibus', 'libpinyin')]

[org/gnome/shell]
favorite-apps=['org.gnome.Nautilus.desktop', 'org.gnome.Console.desktop', 'org.gnome.Settings.desktop', 'org.gnome.TextEditor.desktop', 'org.gnome.SystemMonitor.desktop']
welcome-dialog-last-shown-version='999'

[org/gnome/desktop/a11y/applications]
screen-keyboard-enabled=true
