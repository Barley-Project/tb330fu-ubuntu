[Unit]
Description=TB330FU GNOME Wayland session (autologin ubuntu, no display manager)
After=systemd-user-sessions.service systemd-logind.service systemd-udev-settle.service tb330fu-devd.service dbus.service tb330fu-gpu.service
Wants=systemd-logind.service tb330fu-gpu.service tb330fu-touchd.service
# /var/lib/tb330fu/use-plasma selects the old Plasma session (the RAM unit tb330fu-session.service written by stage1) instead of this one
ConditionPathExists=!/var/lib/tb330fu/use-plasma
OnFailure=tb330fu-plasma-fallback.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=ubuntu
PAMName=tb330fu-session
WorkingDirectory=/home/ubuntu
StandardInput=null
Environment=LANG=zh_CN.UTF-8
Environment=XDG_SESSION_TYPE=wayland
Environment=XDG_SESSION_CLASS=user
Environment=XDG_SESSION_DESKTOP=gnome
Environment=XDG_CURRENT_DESKTOP=GNOME
Environment=DESKTOP_SESSION=gnome
Environment=XDG_SEAT=seat0
ExecStart=/usr/bin/gnome-session --session=gnome
Restart=on-failure
RestartSec=10
TimeoutStopSec=20

[Install]
WantedBy=graphical.target
