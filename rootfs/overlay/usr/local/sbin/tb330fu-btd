#!/usr/bin/python3
"""Bluetooth bridge for the MT6768 SoC-integrated combo chip (soc1_0).

The vendor driver bt_drv_connac1x.ko exposes the controller as the character device /dev/stpbt (HCI H4 packets: one packet per read/write, packet type
byte first); there is no HCI_VHCI in the gda kernel.  This daemon opens /dev/stpbt (which powers the BT function and loads its firmware), creates a pty pair,
attaches the BlueZ H4 line discipline to the slave side (btattach -B <slave> -P h4 -> hci0) and copies complete H4 packets in both directions.

Controller quirks handled here (btmon traces):
  * the firmware advertises "Synchronization Train" but answers Read Synchronization Train Parameters (0x0c77) with "Unknown HCI Command"; the kernel's HCI init
    then fails with -EBADRQC (hciconfig hci0 up: "Invalid request code (56)").  The command is answered locally with an all-zero Command Complete.
  * the Bluetooth device address of the firmware is 00:00:46:76:63:01.  The factory address (first 6 bytes of nvdata APCFG/APRDEB/BT_Addr, copied to
    /var/lib/tb330fu/nvram/BT_Addr) is written with the MediaTek vendor command 0xFC1A right after every HCI Reset, before the Reset completion reaches the host.
Needs: bluetooth.ko + hci_uart.ko loaded (tb330fu-conn.sh), bluez (btattach, bluetoothd).
"""
import os
import select
import signal
import struct
import subprocess
import sys
import time
import tty

BDADDR_FILE = "/var/lib/tb330fu/nvram/BT_Addr"
# optional HCI trace in btsnoop format (datalink 1002 = HCI UART H4), readable with `btmon -r` and Wireshark: TB330FU_BTD_TRACE=/var/log/tb330fu/btd.snoop.
# The kernel's monitor channel (what btmon normally records) shows no HCI frames on this kernel, so the bridge records what passes through it instead.
TRACE_PATH = os.environ.get("TB330FU_BTD_TRACE")
TRACE_MAX = 32 << 20
trace_fd = None
trace_bytes = 0
OP_RESET, OP_SYNC_TRAIN, OP_SET_BDADDR = 0x0c03, 0x0c77, 0xfc1a
OP_READ_LOCAL_COMMANDS = 0x1002
# The firmware's "Read Local Supported Commands" bitmap has no bit at all in octets 25..28, i.e. it does not claim any of the legacy LE commands (LE Set Scan
# Enable, LE Create Connection, LE Connection Update, LE Read Remote Used Features, the accept list, ...) although it implements them (probed with hcitool:
# accept list size 64, supported states, LE Rand all answer).  Linux builds its LE event mask from that bitmap (hci_le_set_event_mask_sync): without the bits the
# events "LE Read Remote Features Complete" and "LE Connection Update Complete" stay masked.  A new connection then never leaves the configuration state ("LE Read
# Remote Used Features" is sent, its completion never arrives), nothing is sent over L2CAP/SMP and every pairing times out; the accept list is never initialised
# either.  Octet 25: LE Set Event Mask .. LE Set Advertising Data (not the reserved bit 3), 26: scan response data .. clear accept list, 27: add accept list ..
# LE Rand, 28: LE Start Encryption, LTK request replies, LE Read Supported States (bit numbers: BlueZ tools/monitor/packet.c, commands_table).
LE_COMMAND_BITS = {25: 0xf7, 26: 0xff, 27: 0xff, 28: 0x0f}


def h4_total(buf):
    """total length of the H4 packet at the start of buf, or None while the header is incomplete; -1 for an unknown packet type"""
    t = buf[0]
    if t in (0x01, 0x03):          # command / SCO: type, 2 bytes opcode|handle, 1 byte length
        return 4 + buf[3] if len(buf) >= 4 else None
    if t == 0x02:                  # ACL: type, handle(2), length(2)
        return 5 + (buf[3] | buf[4] << 8) if len(buf) >= 5 else None
    if t == 0x04:                  # event: type, event code, length(1)
        return 3 + buf[2] if len(buf) >= 3 else None
    if t == 0x05:                  # ISO: type, handle(2), length(14 bit)
        return 5 + ((buf[3] | buf[4] << 8) & 0x3fff) if len(buf) >= 5 else None
    return -1


class Framer:
    def __init__(self):
        self.buf = bytearray()

    def feed(self, data):
        self.buf += data
        out = []
        while self.buf:
            total = h4_total(self.buf)
            if total == -1:
                del self.buf[0]    # lost sync: an unknown type cannot be framed, drop the byte
                continue
            if total is None or len(self.buf) < total:
                break
            out.append(bytes(self.buf[:total]))
            del self.buf[:total]
        return out


def log(*a):
    print("tb330fu-btd:", *a, flush=True)


def event_opcode(pkt):
    """opcode of a Command Complete / Command Status event, else None"""
    if pkt[0] == 0x04 and pkt[1] == 0x0e and len(pkt) >= 6:
        return pkt[4] | pkt[5] << 8
    if pkt[0] == 0x04 and pkt[1] == 0x0f and len(pkt) >= 7:
        return pkt[5] | pkt[6] << 8
    return None


def trace(pkt, to_host):
    """append one H4 packet to the trace file (direction: 1 = controller -> host, 0 = host -> controller)"""
    global trace_bytes
    if trace_fd is None or trace_bytes > TRACE_MAX:
        return
    ts = int(time.time() * 1000000) + 0x00dcddb30f2f8000          # btsnoop timestamps: microseconds since 0000-01-01
    rec = struct.pack(">IIIIq", len(pkt), len(pkt), 1 if to_host else 0, 0, ts) + bytes(pkt)
    trace_fd.write(rec)
    trace_bytes += len(rec)


if TRACE_PATH:
    os.makedirs(os.path.dirname(TRACE_PATH), exist_ok=True)
    trace_fd = open(TRACE_PATH, "wb", buffering=0)
    trace_fd.write(b"btsnoop\x00" + struct.pack(">II", 1, 1002))
    print("tb330fu-btd: tracing HCI to", TRACE_PATH, flush=True)

bdaddr = None
try:
    raw = open(BDADDR_FILE, "rb").read(6)
    if len(raw) == 6 and raw not in (bytes(6), b"\xff" * 6):
        bdaddr = bytes(reversed(raw))      # the file holds the address in display order, HCI wants it little endian
        log("factory BD address", ":".join("%02x" % b for b in raw))
except OSError as e:
    log("no factory BD address (%s), the firmware default stays" % e)

bt = os.open("/dev/stpbt", os.O_RDWR | os.O_NOCTTY)
log("opened /dev/stpbt")
master, slave = os.openpty()
tty.setraw(master)
tty.setraw(slave)
slave_name = os.ttyname(slave)
log("pty slave", slave_name)
att = subprocess.Popen(["/usr/bin/btattach", "-B", slave_name, "-P", "h4"])


def stop(*_):
    att.terminate()
    sys.exit(0)


signal.signal(signal.SIGTERM, stop)
signal.signal(signal.SIGINT, stop)
host_framer = Framer()
ctl_framer = Framer()
held = None           # Reset completion held back while the BD address is being written
held_until = 0.0
while True:
    timeout = 1.0
    if held is not None:
        timeout = max(0.0, held_until - time.time())
    r, _, _ = select.select([bt, master], [], [], timeout)
    if att.poll() is not None:
        sys.exit("btattach exited with %s" % att.returncode)
    if held is not None and time.time() >= held_until:
        log("no reply to the vendor BD address command, continuing")
        os.write(master, held)
        trace(held, True)
        held = None
    if bt in r:
        data = os.read(bt, 4096)
        if not data:
            sys.exit("/dev/stpbt closed")
        for pkt in ctl_framer.feed(data):
            op = event_opcode(pkt)
            if held is None and bdaddr and op == OP_RESET and pkt[1] == 0x0e:
                held = pkt
                held_until = time.time() + 1.0
                os.write(bt, bytes([0x01, OP_SET_BDADDR & 0xff, OP_SET_BDADDR >> 8, 6]) + bdaddr)
            elif held is not None and op == OP_SET_BDADDR:
                log("BD address written, status %s" % ("ok" if pkt[1] == 0x0f and pkt[3] == 0 or pkt[1] == 0x0e and pkt[6] == 0 else "failed"))
                os.write(master, held)
                trace(held, True)
                held = None
            else:
                if op == OP_READ_LOCAL_COMMANDS and pkt[1] == 0x0e and len(pkt) >= 7 + 64 and pkt[6] == 0:
                    b = bytearray(pkt)
                    for octet, bits in LE_COMMAND_BITS.items():
                        b[7 + octet] |= bits
                    pkt = bytes(b)
                    log("supported-commands bitmap: legacy LE commands (octets 25..28) claimed")
                os.write(master, pkt)
                trace(pkt, True)
    if master in r:
        try:
            data = os.read(master, 4096)
        except OSError:
            continue
        for pkt in host_framer.feed(data):
            if pkt[0] == 0x01 and (pkt[1] | pkt[2] << 8) == OP_SYNC_TRAIN:
                # Command Complete: ncmd 1, opcode, status 0 + interval(2) + timeout(4) + service data(1)
                trace(pkt, False)
                local = bytes([0x04, 0x0e, 0x0b, 0x01, OP_SYNC_TRAIN & 0xff, OP_SYNC_TRAIN >> 8]) + bytes(8)
                os.write(master, local)
                trace(local, True)
            else:
                os.write(bt, pkt)
                trace(pkt, False)
