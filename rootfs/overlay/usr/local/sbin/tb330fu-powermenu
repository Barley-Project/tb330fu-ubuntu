#!/usr/bin/python3
"""Power menu of the TB330FU (shown by tb330fu-keysd on a long press of the power key): power off / restart / cancel, big touch-friendly buttons.
Closes itself after 30 s, on Escape and on "cancel"."""
import subprocess
import sys

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
from gi.repository import Gdk, Gio, GLib, Gtk  # noqa: E402

CSS = b"""
window.tb-power { background: #26282c; border-radius: 28px; border: 1px solid #484c54; }
label.tb-title { font-size: 30px; font-weight: bold; margin: 36px 40px 12px 40px; color: #ffffff; }
button.tb-btn { font-size: 32px; min-height: 130px; min-width: 560px; margin: 10px 40px; border-radius: 20px; }
button.tb-last { margin-bottom: 40px; }
"""


class App(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="tb330fu.powermenu", flags=Gio.ApplicationFlags.NON_UNIQUE)

    def do_activate(self):
        css = Gtk.CssProvider()
        css.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        win = Gtk.ApplicationWindow(application=self)
        win.set_decorated(False)
        win.set_resizable(False)
        win.add_css_class("tb-power")
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        title = Gtk.Label(label="电源")
        title.add_css_class("tb-title")
        box.append(title)
        for label, action, style in (("关机", ["systemctl", "poweroff"], "destructive-action"), ("重启", ["systemctl", "reboot"], None), ("取消", None, None)):
            b = Gtk.Button(label=label)
            b.add_css_class("tb-btn")
            if style:
                b.add_css_class(style)
            if action is None:
                b.add_css_class("tb-last")
            b.connect("clicked", self.on_click, action)
            box.append(b)
        win.set_child(box)
        key = Gtk.EventControllerKey()
        key.connect("key-pressed", lambda c, keyval, *_: self.quit() if keyval == Gdk.KEY_Escape else None)
        win.add_controller(key)
        win.present()
        GLib.timeout_add_seconds(30, self.quit)

    def on_click(self, button, action):
        if action:
            subprocess.Popen(action)
        self.quit()


sys.exit(App().run([]))
