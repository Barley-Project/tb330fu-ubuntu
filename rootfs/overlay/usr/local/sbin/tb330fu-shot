#!/bin/sh
# Print the buffer the panel is scanning as raw bytes on stdout: 4864 x 1920 bytes of a8r8g8b8 (BGRA in memory), native portrait.
# Sources, first that exists: /sys/kernel/tb330fu_shot/cur (tb330fu_shot.ko: follows the buffer flip of simpledrm),
# /sys/kernel/tb330fu/fb0 (tb330fu_fb.ko: buffer 0 only).  Root only.  The PC side converts it: devtools/tb.sh shot
f=/sys/kernel/tb330fu_shot/cur
[ -e "$f" ] || f=/sys/kernel/tb330fu/fb0
cat "$f"
