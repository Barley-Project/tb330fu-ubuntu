# Kconfig fragment applied on top of the debug kernel's configuration (scripts/kernel/build-kernel.sh).
# The base is the GKI configuration of the vendor kernel; these are the things a general-purpose Linux userspace (Ubuntu, GNOME, LXC/Waydroid,
# Bluetooth) needs and that GKI leaves out.  Rule: nothing that changes the layout of a structure the vendor modules use (task_struct, ...);
# scripts/kernel/crc-compare.py proves it afterwards (changed export CRCs that some vendor module imports would stop it from loading).

# ---- containers (LXC, Waydroid, bubblewrap/flatpak, systemd sandboxing)
# NOT here: CONFIG_CGROUP_DEVICE and CONFIG_CGROUP_PIDS.  They add controllers to cgroup_subsys.h, which changes CGROUP_SUBSYS_COUNT, the size of
# css_set.subsys[] / cgroup.subsys[] and thereby the CRC of 6058 of the 16008 exported symbols (measured): no vendor module would load.  Device access control
# of a container works on cgroup v2 through a BPF_PROG_TYPE_CGROUP_DEVICE program (CGROUP_BPF is on), which is what LXC uses there.
CONFIG_PID_NS=y
CONFIG_USER_NS=y
# IPC_NS needs SYSVIPC or POSIX_MQUEUE.  SYSVIPC adds sysvsem/sysvshm to task_struct (ABI of every vendor module), POSIX_MQUEUE does not.
CONFIG_POSIX_MQUEUE=y
CONFIG_IPC_NS=y
CONFIG_FHANDLE=y
CONFIG_NETFILTER_XT_TARGET_CHECKSUM=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_DMABUF_HEAPS_SYSTEM=y

# ---- Bluetooth: BNEP (PAN) missing, RFCOMM/HIDP are modules but were never shipped; AF_ALG for bluetoothd and friends
CONFIG_BT_BNEP=m
CONFIG_BT_BNEP_MC_FILTER=y
CONFIG_BT_BNEP_PROTO_FILTER=y
# virtual HCI (/dev/vhci): an alternative to the btattach + pty bridge of tb330fu-btd; USB Bluetooth dongles
CONFIG_BT_HCIVHCI=m
CONFIG_BT_HCIBTUSB=m
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_CRYPTO_USER_API_RNG=y
CONFIG_CRYPTO_USER_API_AEAD=y

# ---- filesystems that Ubuntu userspace expects (snap, AppImage; ACLs/xattrs on tmpfs for systemd and the desktop)
CONFIG_SQUASHFS=m
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_SQUASHFS_LZ4=y
CONFIG_TMPFS_XATTR=y
CONFIG_TMPFS_POSIX_ACL=y

# NOT here: turning off CONFIG_MODULE_SIG_PROTECT (GKI module protection).  It removes CONFIG_MODULE_SCMVERSION and changes struct module, which is part of
# the CRC of ~700 exported symbols (everything that mentions a struct device_driver, file_operations, ...): no vendor module would load.  The protection
# stays on; the vendor modules that use protected exports still get through with tb330fu_gkiunlock (docs/02-boot-and-kernel.md).  The in-tree modules of a
# build are signed with that build's own ephemeral key, so only modules of the build that is in boot.img can be loaded (scripts/kernel/stage-modules.sh).
